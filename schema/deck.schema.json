{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidekick.dev/schema/deck.schema.json",
  "title": "Slidekick deck",
  "description": "A Slidekick deck. Agents compose elements inside named layout regions; the theme decides how everything looks. Never write raw HTML.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "theme", "aspect", "slides"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1, "description": "Schema version. Older decks are migrated on load." },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "theme": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Theme name; see the theme catalogue resource." },
    "aspect": { "enum": ["16:9", "4:3"] },
    "slides": { "type": "array", "items": { "$ref": "#/$defs/slide" }, "maxItems": 300 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Stable id. Keep it when editing so patches stay precise and morph transitions can match elements across slides."
    },
    "colorToken": {
      "enum": ["bg", "surface", "text", "muted", "accent", "accent2"],
      "description": "Theme colour token."
    },
    "slide": {
      "type": "object",
      "required": ["id", "layout", "regions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layout": {
          "enum": ["title", "title-body", "two-column", "hero-image", "big-number", "quote", "grid-3", "full-bleed"],
          "description": "Layout preset; see the layout catalogue resource for each layout's region names."
        },
        "regions": {
          "type": "object",
          "description": "Map of region name to the elements placed in it, in order.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/element" }, "maxItems": 12 }
        },
        "transition": { "$ref": "#/$defs/transition" },
        "notes": { "type": "string", "maxLength": 5000, "description": "Speaker notes." },
        "background": { "$ref": "#/$defs/background" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["none", "fade", "slide", "zoom", "push", "morph"],
          "description": "How this slide enters. 'morph' animates elements that share an id with the previous slide."
        },
        "duration": { "enum": ["fast", "base", "slow"] }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": { "$ref": "#/$defs/colorToken" },
        "image": { "type": "string", "minLength": 1, "description": "Image URL." },
        "dim": { "type": "number", "minimum": 0, "maximum": 0.9, "description": "Darken an image background for legibility." }
      }
    },
    "build": {
      "type": "object",
      "required": ["step"],
      "additionalProperties": false,
      "description": "Reveal this element on a build step. Elements without a build are visible when the slide appears.",
      "properties": {
        "step": { "type": "integer", "minimum": 1, "maximum": 20 },
        "preset": { "enum": ["fade", "fade-up", "scale-in", "wipe", "typewriter"], "default": "fade-up" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides limited to theme tokens.",
      "properties": {
        "color": { "$ref": "#/$defs/colorToken" },
        "size": { "enum": ["xs", "sm", "md", "lg", "xl", "xxl"] },
        "align": { "enum": ["start", "center", "end"] },
        "weight": { "enum": ["regular", "bold"] },
        "colorRaw": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Escape hatch: a raw hex colour. Prefer 'color'; lint warns when this is used."
        }
      }
    },
    "inline": {
      "type": "string",
      "description": "Rich inline text: **bold**, *italic*, `code` and [link](https://...) are supported."
    },
    "element": {
      "type": "object",
      "required": ["id", "type", "props"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["heading", "text", "bullets", "image", "code", "stat", "quote"] },
        "props": { "type": "object" },
        "style": { "$ref": "#/$defs/style" },
        "build": { "$ref": "#/$defs/build" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "heading" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/props-heading" } } }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/props-text" } } }
        },
        {
          "if": { "properties": { "type": { "const": "bullets" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/props-bullets" } } }
        },
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/props-image" } } }
        },
        {
          "if": { "properties": { "type": { "const": "code" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/props-code" } } }
        },
        {
          "if": { "properties": { "type": { "const": "stat" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/props-stat" } } }
        },
        {
          "if": { "properties": { "type": { "const": "quote" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/props-quote" } } }
        }
      ]
    },
    "props-heading": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/inline", "minLength": 1, "maxLength": 200 },
        "level": { "enum": [1, 2, 3], "default": 1 }
      }
    },
    "props-text": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/inline", "minLength": 1, "maxLength": 2000 }
      }
    },
    "props-bullets": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/inline", "minLength": 1, "maxLength": 400 } },
        "ordered": { "type": "boolean" },
        "buildEach": { "type": "boolean", "description": "Reveal items one build step at a time, starting at this element's build step." }
      }
    },
    "props-image": {
      "type": "object",
      "required": ["src"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "maxLength": 300, "description": "Required for accessibility unless purely decorative (then set decorative: true)." },
        "decorative": { "type": "boolean" },
        "fit": { "enum": ["cover", "contain"], "default": "cover" },
        "caption": { "type": "string", "maxLength": 200 }
      }
    },
    "props-code": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "language": { "type": "string", "maxLength": 40 }
      }
    },
    "props-stat": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "description": "Counts up from zero when the element appears." },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
        "prefix": { "type": "string", "maxLength": 8 },
        "suffix": { "type": "string", "maxLength": 12 },
        "label": { "type": "string", "maxLength": 120 }
      }
    },
    "props-quote": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/inline", "minLength": 1, "maxLength": 500 },
        "attribution": { "type": "string", "maxLength": 120 }
      }
    }
  }
}

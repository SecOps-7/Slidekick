      "accent2": "#62e3ff"
    },
    "font": {
      "heading": "\"Atkinson Hyperlegible Next\", system-ui, sans-serif",
      "body": "\"Atkinson Hyperlegible Next\", system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, monospace"
    },
    "fonts": [
      "atkinson-hyperlegible-next",
      "jetbrains-mono"
    ],
    "size": {
      "xs": 26,
      "sm": 32,
      "md": 40,
      "lg": 58,
      "xl": 84,
      "xxl": 128
    },
    "radius": 10,
    "motion": {

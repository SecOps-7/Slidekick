{
  "name": "slidekick-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-icons.mjs && node scripts/gen-types.mjs && node scripts/gen-validator.mjs && tsc --noEmit && vite build && vite build -c vite.standalone.config.ts && SK_LITE=1 vite build -c vite.standalone.config.ts && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "fonts": "node scripts/gen-fonts.mjs",
    "test": "vitest run",
    "types": "node scripts/gen-types.mjs && node scripts/gen-validator.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tabler/icons": "^3.52.0",
    "happy-dom": "^21.0.4",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "mermaid": "^11.17.2",
    "motion": "^14.14.0",
    "preact": "^10.29.8",
    "shiki": "^3.23.0"
  }
}
